# Скопіюйте цей файл у налаштування Environment variables вашого сайту в Netlify
# (Site settings → Environment variables). НЕ комітьте реальні значення в git.

# ---- WayForPay ----
# Сам платіж іде через готову кнопку/посилання з кабінету WayForPay
# (підпис генерує кабінет, а не наш код). Секретний ключ усе одно потрібен: ним
# наша функція payment-callback.js перевіряє, що вхідне сповіщення про оплату
# справді від WayForPay, а не підробка.
WFP_MERCHANT_SECRET=

# ---- Публічна адреса сайту (без / в кінці) ----
SITE_URL=https://ads-guide-landing.netlify.app

# ---- Email-розсилка гайду (Resend, https://resend.com — є безкоштовний план) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL="Kristina Lipinskaya <guide@your-domain.com>"

# ---- Meta Conversions API (Events Manager → Налаштування → Access Token) ----
META_PIXEL_ID=
META_CAPI_TOKEN=

# ---- Telegram-бот (видача PDF через deep-link "t.me/бот?start=токен") ----
# Створюється через @BotFather. TOKEN — секрет, USERNAME — публічний (без @).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
